# Gamantaray ASV ArduRover SITL defaults.
# Loaded only when using:
# ros2 launch gamantaray_boat_sim simple_ocean_gamantaray.launch.py navigation_mode:=ardupilot

# Differential / skid motorboat output. These match the ArduPilotPlugin
# control channels in models/gamantaray_boat/model.sdf.
FRAME_CLASS 2
SERVO1_FUNCTION 73
SERVO3_FUNCTION 74
SERVO1_REVERSED 0
SERVO3_REVERSED 0
SERVO1_MIN 1000
SERVO1_TRIM 1500
SERVO1_MAX 2000
SERVO3_MIN 1000
SERVO3_TRIM 1500
SERVO3_MAX 2000

# Keep SITL bring-up deterministic in Gazebo. Real hardware must not copy
# these safety relaxations without a separate safety review.
ARMING_CHECK 0
BRD_SAFETYENABLE 0

# ASV defaults for the 100 x 20 m TEKNOFEST course. The speed is kept moderate
# because this Gazebo hull has inertia and water drag; too much throttle makes
# ArduPilot overshoot WP4-WP5 and leave the narrow corridor.
CRUISE_SPEED 2.2
CRUISE_THROTTLE 68
WP_SPEED 2.2
WP_RADIUS 8.0
WP_OVERSHOOT 8.0
ATC_BRAKE 0
ATC_STR_ACC_MAX 90
ATC_STR_RAT_FF 0.25
ATC_STR_RAT_P 0.22
ATC_STR_RAT_I 0.08
ATC_STR_RAT_MAX 95
ATC_TURN_MAX_G 0.55
TURN_RADIUS 0.6
WP_PIVOT_ANGLE 0
WP_PIVOT_RATE 45
PILOT_STEER_TYPE 0

# MAVLink proximity input from /asv/lidar/scan via MAVROS.
# ArduPilot docs use PRX1_TYPE=2 for MAVLink proximity data.
PRX1_TYPE 2
PRX1_MIN 0.8
PRX1_MAX 10.0
PRX1_ORIENT 0
AVOID_ENABLE 7
AVOID_MARGIN 1.5

# Object avoidance path planner. OA_TYPE=3 enables Dijkstra + BendyRuler, but
# it is enabled by ardupilot_waypoint_mission after EKF origin and proximity
# data are alive. Enabling it at SITL boot can panic ArduRover while the
# simulated location is still invalid.
OA_TYPE 0
OA_BR_TYPE 1
OA_BR_LOOKAHEAD 5.0
OA_MARGIN_MAX 1.5
OA_OPTIONS 0
OA_DB_SIZE 750
OA_DB_EXPIRE 3
OA_DB_QUEUE_SIZE 100
OA_DB_OUTPUT 2
OA_DB_BEAM_WIDTH 5
OA_DB_RADIUS_MIN 0.35
OA_DB_DIST_MAX 10
OA_DB_ALT_MIN 0
