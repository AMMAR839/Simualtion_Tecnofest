Panels:
  - Class: rviz_common/Displays
    Help Height: 70
    Name: Displays
    Property Tree Widget:
      Expanded:
        - /Global Options1
        - /Boat Model1
        - /Local Window1
        - /LiDAR Buoy Detections1
        - /Global Path1
      Splitter Ratio: 0.5
    Tree Height: 760
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Cell Size: 2
      Color: 110; 110; 110
      Enabled: true
      Line Style:
        Line Width: 0.015
        Value: Lines
      Name: Grid
      Plane: XY
      Plane Cell Count: 34
      Reference Frame: odom
      Value: true
    - Class: rviz_default_plugins/MarkerArray
      Enabled: true
      Name: Boat Model
      Namespaces:
        hull_deck: true
      Topic:
        Durability Policy: Volatile
        Reliability Policy: Reliable
        Value: /asv/visualization/boat_model
      Value: true
    - Class: rviz_default_plugins/MarkerArray
      Enabled: true
      Name: Local Window
      Namespaces:
        local_window_fill: false
        local_window_outline: true
      Topic:
        Durability Policy: Transient Local
        Reliability Policy: Reliable
        Value: /asv/visualization/local_window
      Value: true
    - Class: rviz_default_plugins/MarkerArray
      Enabled: true
      Name: LiDAR Buoy Detections
      Namespaces:
        lidar_cluster: true
      Topic:
        Durability Policy: Volatile
        Reliability Policy: Reliable
        Value: /asv/perception/lidar_obstacles
      Value: true
    - Alpha: 0.92
      Class: rviz_default_plugins/Map
      Color Scheme: costmap
      Draw Behind: false
      Enabled: true
      Name: Local Obstacles
      Topic:
        Durability Policy: Transient Local
        Reliability Policy: Reliable
        Value: /local_costmap/costmap
      Update Topic:
        Durability Policy: Volatile
        Reliability Policy: Reliable
        Value: /local_costmap/costmap_updates
      Use Timestamp: false
      Value: true
    - Class: rviz_default_plugins/Polygon
      Color: 255; 255; 255
      Enabled: true
      Name: Local Footprint
      Topic:
        Durability Policy: Volatile
        Reliability Policy: Reliable
        Value: /local_costmap/published_footprint
      Value: true
    - Alpha: 1
      Buffer Length: 1
      Class: rviz_default_plugins/Path
      Color: 45; 160; 255
      Enabled: true
      Head Diameter: 0.28
      Head Length: 0.20
      Length: 0.20
      Line Style: Billboards
      Line Width: 0.16
      Name: Global Path
      Offset:
        X: 0
        Y: 0
        Z: 0.45
      Pose Color: 45; 160; 255
      Pose Style: None
      Radius: 0.05
      Shaft Diameter: 0.10
      Shaft Length: 0.20
      Topic:
        Value: /plan
      Value: true
    - Alpha: 1
      Buffer Length: 1
      Class: rviz_default_plugins/Path
      Color: 50; 255; 120
      Enabled: true
      Line Style: Billboards
      Line Width: 0.08
      Name: Smoothed Path
      Offset:
        X: 0
        Y: 0
        Z: 0.55
      Pose Color: 50; 255; 120
      Pose Style: None
      Topic:
        Value: /plan_smoothed
      Value: true
  Enabled: true
  Global Options:
    Background Color: 24; 27; 31
    Fixed Frame: odom
    Frame Rate: 15
  Name: root
  Tools:
    - Class: rviz_default_plugins/Interact
      Hide Inactive Objects: true
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
    - Class: rviz_default_plugins/SetGoal
      Topic:
        Value: /goal_pose
  Transformation:
    Current:
      Class: rviz_default_plugins/TF
  Value: true
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 18
      Focal Point:
        X: 0
        Y: 0
        Z: 0
      Name: Follow ASV
      Pitch: 1.55
      Target Frame: base_link
      Yaw: 0.0
    Saved: ~
Window Geometry:
  Height: 1048
  Width: 926
  X: 994
  Y: 32
