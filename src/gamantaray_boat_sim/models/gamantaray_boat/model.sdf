<?xml version="1.0"?>
<sdf version="1.9">
  <model name="gamantaray_boat">
    <pose>0 0 0 0 0 0</pose>

    <link name="base_link">
      <inertial>
        <pose>0 0 0 0 0 0</pose>
        <mass>35.0</mass>
        <inertia>
          <ixx>8.0</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>18.0</iyy>
          <iyz>0</iyz>
          <izz>22.0</izz>
        </inertia>
      </inertial>

      <visual name="assembly_visual">
        <pose>-1.144 0 -0.638 0 0 0</pose>
        <geometry>
          <mesh>
            <uri>model://gamantaray_boat/meshes/assembly_2_0.obj</uri>
            <scale>0.02 0.02 0.02</scale>
          </mesh>
        </geometry>
      </visual>

      <collision name="main_hull_collision">
        <pose>0 0 -0.05 0 0 0</pose>
        <geometry>
          <box>
            <size>2.4 1.35 0.45</size>
          </box>
        </geometry>
      </collision>

      <visual name="left_thruster_visual">
        <pose>-0.85 0.45 -0.2 0 1.5708 0</pose>
        <geometry>
          <cylinder>
            <radius>0.08</radius>
            <length>0.25</length>
          </cylinder>
        </geometry>
        <material>
          <diffuse>0.02 0.02 0.02 1</diffuse>
        </material>
      </visual>

      <visual name="right_thruster_visual">
        <pose>-0.85 -0.45 -0.2 0 1.5708 0</pose>
        <geometry>
          <cylinder>
            <radius>0.08</radius>
            <length>0.25</length>
          </cylinder>
        </geometry>
        <material>
          <diffuse>0.02 0.02 0.02 1</diffuse>
        </material>
      </visual>

      <sensor name="front_camera" type="camera">
        <pose>0.85 0 0.55 0 0.17 0</pose>
        <camera>
          <horizontal_fov>1.3962634</horizontal_fov>
          <image>
            <width>1280</width>
            <height>720</height>
            <format>R8G8B8</format>
          </image>
          <clip>
            <near>0.05</near>
            <far>120</far>
          </clip>
        </camera>
        <always_on>true</always_on>
        <update_rate>30</update_rate>
        <visualize>true</visualize>
        <topic>front_camera/image</topic>
      </sensor>

      <sensor name="front_lidar" type="gpu_lidar">
        <pose>0.65 0 0.75 0 0 0</pose>
        <lidar>
          <scan>
            <horizontal>
              <samples>720</samples>
              <resolution>1</resolution>
              <min_angle>-2.35619</min_angle>
              <max_angle>2.35619</max_angle>
            </horizontal>
          </scan>
          <range>
            <min>0.15</min>
            <max>60.0</max>
            <resolution>0.01</resolution>
          </range>
        </lidar>
        <always_on>true</always_on>
        <update_rate>10</update_rate>
        <visualize>true</visualize>
        <topic>front_lidar/scan</topic>
      </sensor>
    </link>

    <plugin filename="gz-sim-velocity-control-system" name="gz::sim::systems::VelocityControl"/>

  </model>
</sdf>
