<?xml version="1.0"?>
<sdf version="1.9">
  <model name="gamantaray_boat">
    <pose>0 0 0 0 0 0</pose>

    <link name="base_link">
      <gravity>true</gravity>
      <pose>0 0 0 0 0 0</pose>
      
      <inertial>
        <pose>0 0 -0.05 0 0 0</pose>
        <mass>55.0</mass>
        <inertia>
          <ixx>16.0</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>40.0</iyy>
          <iyz>0</iyz>
          <izz>36.0</izz>
        </inertia>
      </inertial>

      <visual name="assembly_visual">
        <!-- Visual waterline offset for the imported OBJ. Buoyancy is handled
             by the two pontoon collision volumes below. -->
        <pose>-1.144 0 -0.28 0 0 0</pose>
        <geometry>
          <mesh>
            <uri>model://gamantaray_boat/meshes/assembly_2_0.obj</uri>
            <scale>0.02 0.02 0.02</scale>
          </mesh>
        </geometry>
      </visual>

      <collision name="main_hull_collision">
        <pose>0 0 0.1 0 0 0</pose>
        <geometry>
          <box>
            <size>1.175 0.82 0.45</size>
          </box>
        </geometry>
        <surface>
          <contact>
            <collide_without_contact>false</collide_without_contact>
          </contact>
        </surface>
      </collision>

      <collision name="left_buoyancy_volume">
        <pose>0 0.36 -0.24 0 0 0</pose>
        <geometry>
          <box>
            <size>1.50 0.28 0.14</size>
          </box>
        </geometry>
        <surface>
          <contact>
            <collide_without_contact>true</collide_without_contact>
          </contact>
        </surface>
      </collision>

      <collision name="right_buoyancy_volume">
        <pose>0 -0.36 -0.24 0 0 0</pose>
        <geometry>
          <box>
            <size>1.50 0.28 0.14</size>
          </box>
        </geometry>
        <surface>
          <contact>
            <collide_without_contact>true</collide_without_contact>
          </contact>
        </surface>
      </collision>

      <visual name="lidar_mast_visual">
        <pose>0.52 0 0.78 0 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.025</radius>
            <length>1.42</length>
          </cylinder>
        </geometry>
        <material>
          <diffuse>0.65 0.65 0.65 1</diffuse>
        </material>
      </visual>

      <visual name="sensor_crossbar_visual">
        <pose>0.52 0 0.98 0 0 0</pose>
        <geometry>
          <box>
            <size>0.16 0.40 0.05</size>
          </box>
        </geometry>
        <material>
          <diffuse>0.72 0.72 0.72 1</diffuse>
        </material>
      </visual>

      <sensor name="imu_sensor" type="imu">
        <topic>/asv/imu/data</topic>
        <always_on>true</always_on>
        <update_rate>100</update_rate>
      </sensor>

      <!-- ArduPilotPlugin subscribes to the Gazebo-scoped default IMU topic.
           Keep the /asv/imu/data sensor above for ROS, and use this one only
           for the ArduPilot JSON sensor feedback loop. -->
      <sensor name="ardupilot_imu_sensor" type="imu">
        <always_on>true</always_on>
        <update_rate>100</update_rate>
      </sensor>

      <sensor name="gps_sensor" type="navsat">
        <pose>0.52 0 1.00 0 0 0</pose>
        <topic>/asv/gps/fix</topic>
        <always_on>true</always_on>
        <update_rate>10</update_rate>
        <navsat>
          <position_sensing>
            <horizontal>
              <noise type="gaussian">
                <mean>0</mean>
                <stddev>0.4</stddev>
              </noise>
            </horizontal>
            <vertical>
              <noise type="gaussian">
                <mean>0</mean>
                <stddev>0.8</stddev>
              </noise>
            </vertical>
          </position_sensing>
        </navsat>
      </sensor>

      <sensor name="lidar_sensor" type="gpu_lidar">
        <!-- The GPU LiDAR ray is kept low enough to intersect the visual
             body/flag pole of 0.5 m TEKNOFEST buoys, while placed forward of
             the hull collision to avoid reading the boat itself. -->
        <pose>0.95 0 0.32 0 0 0</pose>
        <topic>/asv/lidar/scan_raw</topic>
        <always_on>true</always_on>
        <visualize>true</visualize>
        <update_rate>15</update_rate>
        <lidar>
          <scan>
            <horizontal>
              <samples>720</samples>
              <resolution>1</resolution>
              <min_angle>-3.14159</min_angle>
              <max_angle>3.14159</max_angle>
            </horizontal>
            <vertical>
              <samples>1</samples>
              <resolution>1</resolution>
              <min_angle>0</min_angle>
              <max_angle>0</max_angle>
            </vertical>
          </scan>
          <range>
            <min>0.45</min>
            <max>10.0</max>
            <resolution>0.02</resolution>
          </range>
          <noise>
            <type>gaussian</type>
            <mean>0.0</mean>
            <stddev>0.015</stddev>
          </noise>
        </lidar>
      </sensor>

      <sensor name="front_camera_sensor" type="camera">
        <pose>0.85 0 1.25 0 0.10 0</pose>
        <topic>/asv/camera/front/image</topic>
        <always_on>true</always_on>
        <update_rate>10</update_rate>
        <visualize>true</visualize>
        <camera>
          <horizontal_fov>1.3962634</horizontal_fov>
          <image>
            <width>640</width>
            <height>360</height>
            <format>R8G8B8</format>
          </image>
          <clip>
            <near>0.05</near>
            <far>80.0</far>
          </clip>
        </camera>
      </sensor>
    </link>

    <link name="left_propeller_link">
      <gravity>true</gravity>
      <pose relative_to="left_propeller_joint">0 0 0 0 0 0</pose>
      <collision name="left_propeller_collision">
        <pose>0 0 0 0 1.570796 0</pose>
        <geometry>
          <cylinder>
            <radius>0.075</radius>
            <length>0.025</length>
          </cylinder>
        </geometry>
      </collision>
      <inertial>
        <mass>0.10</mass>
        <inertia>
          <ixx>0.00010</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>0.00010</iyy>
          <iyz>0</iyz>
          <izz>0.00015</izz>
        </inertia>
      </inertial>
    </link>
    
    <joint name="left_propeller_joint" type="revolute">
      <pose relative_to="base_link">-1.05 0.41 -0.35 0 0 0</pose>
      <parent>base_link</parent>
      <child>left_propeller_link</child>
      <axis>
        <xyz>1 0 0</xyz>
        <limit>
          <lower>-1e+16</lower>
          <upper>1e+16</upper>
          <effort>120</effort>
          <velocity>900</velocity>
        </limit>
        <dynamics>
          <damping>0.04</damping>
          <friction>0.01</friction>
        </dynamics>
      </axis>
    </joint>

    <link name="right_propeller_link">
      <gravity>true</gravity>
      <pose relative_to="right_propeller_joint">0 0 0 0 0 0</pose>
      <collision name="right_propeller_collision">
        <pose>0 0 0 0 1.570796 0</pose>
        <geometry>
          <cylinder>
            <radius>0.075</radius>
            <length>0.025</length>
          </cylinder>
        </geometry>
      </collision>
      <inertial>
        <mass>0.10</mass>
        <inertia>
          <ixx>0.00010</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>0.00010</iyy>
          <iyz>0</iyz>
          <izz>0.00015</izz>
        </inertia>
      </inertial>
    </link>
    
    <joint name="right_propeller_joint" type="revolute">
      <pose relative_to="base_link">-1.05 -0.41 -0.35 0 0 0</pose>
      <parent>base_link</parent>
      <child>right_propeller_link</child>
      <axis>
        <xyz>1 0 0</xyz>
        <limit>
          <lower>-1e+16</lower>
          <upper>1e+16</upper>
          <effort>120</effort>
          <velocity>900</velocity>
        </limit>
        <dynamics>
          <damping>0.04</damping>
          <friction>0.01</friction>
        </dynamics>
      </axis>
    </joint>
    
    <plugin filename="gz-sim-joint-state-publisher-system"
            name="gz::sim::systems::JointStatePublisher"/>

    <plugin filename="gz-sim-odometry-publisher-system"
            name="gz::sim::systems::OdometryPublisher">
      <odom_frame>odom</odom_frame>
      <robot_base_frame>base_link</robot_base_frame>
      <odom_publish_frequency>30</odom_publish_frequency>
      <odom_topic>/asv/odom</odom_topic>
      <dimensions>3</dimensions>
    </plugin>

    <plugin filename="gz-waves1-hydrodynamics-system"
            name="gz::sim::systems::Hydrodynamics">
      <enable>gamantaray_boat::base_link::left_buoyancy_volume</enable>
      <enable>gamantaray_boat::base_link::right_buoyancy_volume</enable>
      <hydrodynamics>
        <damping_on>1</damping_on>
        <viscous_drag_on>1</viscous_drag_on>
        <pressure_drag_on>1</pressure_drag_on>
        <cDampL1>1.0E-5</cDampL1>
        <cDampL2>1.0E-5</cDampL2>
        <cDampR1>1.0E-5</cDampR1>
        <cDampR2>1.0E-5</cDampR2>
        <cPDrag1>100.0</cPDrag1>
        <cPDrag2>110.0</cPDrag2>
        <fPDrag>0.35</fPDrag>
        <cSDrag1>115.0</cSDrag1>
        <cSDrag2>130.0</cSDrag2>
        <fSDrag>0.40</fSDrag>
        <vRDrag>1.0</vRDrag>
      </hydrodynamics>
    </plugin>

    <plugin filename="gz-sim-joint-controller-system"
            name="gz::sim::systems::JointController">
      <joint_name>left_propeller_joint</joint_name>
      <initial_velocity>0.0</initial_velocity>
      <p_gain>0.15</p_gain>
    </plugin>
    <plugin filename="gz-sim-joint-controller-system"
            name="gz::sim::systems::JointController">
      <joint_name>right_propeller_joint</joint_name>
      <initial_velocity>0.0</initial_velocity>
      <p_gain>0.15</p_gain>
    </plugin>

    <plugin filename="gz-sim-thruster-system"
            name="gz::sim::systems::Thruster">
      <joint_name>left_propeller_joint</joint_name>
      <thrust_coefficient>0.01</thrust_coefficient>
      <fluid_density>1000</fluid_density>
      <propeller_diameter>0.15</propeller_diameter>
      <velocity_control>true</velocity_control>
      <use_angvel_cmd>false</use_angvel_cmd>
      <max_thrust_cmd>160</max_thrust_cmd>
      <min_thrust_cmd>-90</min_thrust_cmd>
    </plugin>
    <plugin filename="gz-sim-thruster-system"
            name="gz::sim::systems::Thruster">
      <joint_name>right_propeller_joint</joint_name>
      <thrust_coefficient>0.01</thrust_coefficient>
      <fluid_density>1000</fluid_density>
      <propeller_diameter>0.15</propeller_diameter>
      <velocity_control>true</velocity_control>
      <use_angvel_cmd>false</use_angvel_cmd>
      <max_thrust_cmd>160</max_thrust_cmd>
      <min_thrust_cmd>-90</min_thrust_cmd>
    </plugin>

    <plugin name="ArduPilotPlugin" filename="ArduPilotPlugin">
      <fdm_addr>127.0.0.1</fdm_addr>
      <fdm_port_in>9002</fdm_port_in>
      <connectionTimeoutMaxCount>50</connectionTimeoutMaxCount>
      <lock_step>1</lock_step>
      <no_time_sync>1</no_time_sync>
      <modelXYZToAirplaneXForwardZDown>0 0 0 3.141593 0 0</modelXYZToAirplaneXForwardZDown>
      <gazeboXYZToNED>0 0 0 3.141593 0 0</gazeboXYZToNED>
      <imuName>ardupilot_imu_sensor</imuName>

      <!-- ArduRover skid-steer mapping. The physical propeller joints use
           opposite signs, so the channels are crossed here to make ArduPilot's
           steering correction match Gazebo yaw direction. -->
      <control channel="0">
        <jointName>right_propeller_joint</jointName>
        <useForce>1</useForce>
        <multiplier>16000</multiplier>
        <offset>-0.5</offset>
        <servo_min>1000</servo_min>
        <servo_max>2000</servo_max>
        <type>COMMAND</type>
        <cmd_topic>/model/gamantaray_boat/joint/right_propeller_joint/cmd_thrust</cmd_topic>
      </control>
      <control channel="2">
        <jointName>left_propeller_joint</jointName>
        <useForce>1</useForce>
        <multiplier>-16000</multiplier>
        <offset>-0.5</offset>
        <servo_min>1000</servo_min>
        <servo_max>2000</servo_max>
        <type>COMMAND</type>
        <cmd_topic>/model/gamantaray_boat/joint/left_propeller_joint/cmd_thrust</cmd_topic>
      </control>
    </plugin>
  </model>
</sdf>
