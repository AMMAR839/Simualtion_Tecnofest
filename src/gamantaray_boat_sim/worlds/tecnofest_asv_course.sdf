<?xml version="1.0"?>
<sdf version="1.9">
  <world name="tecnofest_asv_course">
    <gravity>0 0 0</gravity>

    <physics name="tecnofest_4ms" type="dart">
      <max_step_size>0.004</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <spherical_coordinates>
      <surface_model>EARTH_WGS84</surface_model>
      <world_frame_orientation>ENU</world_frame_orientation>
      <latitude_deg>-6.200000</latitude_deg>
      <longitude_deg>106.816666</longitude_deg>
      <elevation>0.0</elevation>
      <heading_deg>0.0</heading_deg>
    </spherical_coordinates>

    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-contact-system" name="gz::sim::systems::Contact"/>
    <plugin filename="gz-sim-navsat-system" name="gz::sim::systems::NavSat"/>
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu"/>

    <scene>
      <ambient>0.75 0.78 0.80 1</ambient>
      <background>0.70 0.82 0.92 1</background>
      <sky/>
    </scene>

    <gui fullscreen="0">
      <plugin filename="MinimalScene" name="3D View">
        <gz-gui>
          <title>3D View</title>
          <property type="bool" key="showTitleBar">false</property>
          <property type="string" key="state">docked</property>
        </gz-gui>
        <engine>ogre2</engine>
        <scene>scene</scene>
        <ambient_light>0.75 0.78 0.80</ambient_light>
        <background_color>0.70 0.82 0.92</background_color>
        <camera_pose>0 -34 30 0 0.86 1.5708</camera_pose>
        <camera_clip>
          <near>0.1</near>
          <far>500</far>
        </camera_clip>
      </plugin>
      <plugin filename="EntityContextMenuPlugin" name="Entity context menu"/>
      <plugin filename="GzSceneManager" name="Scene Manager"/>
      <plugin filename="InteractiveViewControl" name="Interactive view control"/>
      <plugin filename="CameraTracking" name="Camera Tracking"/>
      <plugin filename="Spawn" name="Spawn Entities"/>
      <plugin filename="WorldControl" name="World control">
        <play_pause>true</play_pause>
        <step>true</step>
        <start_paused>false</start_paused>
        <use_event>true</use_event>
      </plugin>
      <plugin filename="WorldStats" name="World stats">
        <sim_time>true</sim_time>
        <real_time>true</real_time>
        <real_time_factor>true</real_time_factor>
        <iterations>true</iterations>
      </plugin>
    </gui>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 40 0 0 0</pose>
      <diffuse>0.95 0.92 0.85 1</diffuse>
      <specular>0.45 0.45 0.45 1</specular>
      <direction>-0.45 0.15 -0.88</direction>
    </light>

    <include>
      <name>tecnofest_ocean_waves</name>
      <pose>0 0 0 0 0 0</pose>
      <uri>model://tecnofest_ocean_waves</uri>
    </include>

    <!-- Startpoint and GN task points from the reference drawing. These are visual-only markers. -->
    <include><name>startpoint_marker</name><pose>-49.0 -8.0 0.02 0 0 0</pose><uri>model://tecnofest_startpoint_black</uri></include>
    <include><name>gn1_task_point</name><pose>-40.0 -4.0 0.02 0 0 0</pose><uri>model://tecnofest_task_point_blue</uri></include>
    <include><name>gn2_task_point</name><pose>-32.0 4.5 0.02 0 0 0</pose><uri>model://tecnofest_task_point_blue</uri></include>
    <include><name>gn3_task_point</name><pose>-24.0 -4.0 0.02 0 0 0</pose><uri>model://tecnofest_task_point_blue</uri></include>
    <include><name>gn4_task_point</name><pose>-16.0 4.5 0.02 0 0 0</pose><uri>model://tecnofest_task_point_blue</uri></include>
    <include><name>gn5_task_point</name><pose>36.5 -1.2 0.02 0 0 0</pose><uri>model://tecnofest_task_point_blue</uri></include>

    <!-- Parkur 1 tuning:
         - edit GN markers above and matching Nav2 waypoints in config/tecnofest_waypoints.yaml
         - edit paired buoys below; each upper/lower pair is the 8-12 m checked distance -->
    <include><name>p1_s1_upper_01</name><pose>-43.6 -0.6 0.0 0 0 0</pose><uri>model://tecnofest_buoy_boundary_orange</uri></include>
    <include><name>p1_s1_upper_02</name><pose>-37.8 5.6 0.0 0 0 0</pose><uri>model://tecnofest_buoy_boundary_orange</uri></include>
    <include><name>p1_s1_upper_03</name><pose>-32.0 11.8 0.0 0 0 0</pose><uri>model://tecnofest_buoy_boundary_orange</uri></include>
    <include><name>p1_s1_lower_01</name><pose>-36.4 -7.4 0.0 0 0 0</pose><uri>model://tecnofest_buoy_boundary_orange</uri></include>
    <include><name>p1_s1_lower_02</name><pose>-34.2 -5.1 0.0 0 0 0</pose><uri>model://tecnofest_buoy_boundary_orange</uri></include>
    <include><name>p1_s1_lower_03</name><pose>-32.0 -2.8 0.0 0 0 0</pose><uri>model://tecnofest_buoy_boundary_orange</uri></include>

    <include><name>p1_s2_upper_01</name><pose>-29.3 9.0 0.0 0 0 0</pose><uri>model://tecnofest_buoy_boundary_orange</uri></include>
    <include><name>p1_s2_upper_02</name><pose>-26.6 6.1 0.0 0 0 0</pose><uri>model://tecnofest_buoy_boundary_orange</uri></include>
    <include><name>p1_s2_upper_03</name><pose>-24.0 3.3 0.0 0 0 0</pose><uri>model://tecnofest_buoy_boundary_orange</uri></include>
    <include><name>p1_s2_lower_01</name><pose>-29.3 -5.6 0.0 0 0 0</pose><uri>model://tecnofest_buoy_boundary_orange</uri></include>
    <include><name>p1_s2_lower_02</name><pose>-26.6 -8.5 0.0 0 0 0</pose><uri>model://tecnofest_buoy_boundary_orange</uri></include>
    <include><name>p1_s2_lower_03</name><pose>-24.0 -11.3 0.0 0 0 0</pose><uri>model://tecnofest_buoy_boundary_orange</uri></include>

    <include><name>p1_s3_upper_01</name><pose>-22.5 4.8 0.0 0 0 0</pose><uri>model://tecnofest_buoy_boundary_orange</uri></include>
    <include><name>p1_s3_upper_02</name><pose>-21.1 6.4 0.0 0 0 0</pose><uri>model://tecnofest_buoy_boundary_orange</uri></include>
    <include><name>p1_s3_upper_03</name><pose>-19.6 7.9 0.0 0 0 0</pose><uri>model://tecnofest_buoy_boundary_orange</uri></include>
    <include><name>p1_s3_lower_01</name><pose>-20.1 -7.2 0.0 0 0 0</pose><uri>model://tecnofest_buoy_boundary_orange</uri></include>
    <include><name>p1_s3_lower_02</name><pose>-16.2 -3.0 0.0 0 0 0</pose><uri>model://tecnofest_buoy_boundary_orange</uri></include>
    <include><name>p1_s3_lower_03</name><pose>-12.4 1.1 0.0 0 0 0</pose><uri>model://tecnofest_buoy_boundary_orange</uri></include>

    <!-- Parkur 2: target buoys in a zig-zag pattern, matching the reference order. -->
    <include><name>p2_top_edge_01</name><pose>-16.0 9.5 0.0 0 0 0</pose><uri>model://tecnofest_buoy_boundary_orange</uri></include>
    <include><name>p2_top_edge_02</name><pose>-11.0 9.0 0.0 0 0 0</pose><uri>model://tecnofest_buoy_boundary_orange</uri></include>
    <include><name>p2_top_edge_03</name><pose>-6.0 8.4 0.0 0 0 0</pose><uri>model://tecnofest_buoy_boundary_orange</uri></include>
    <include><name>p2_top_edge_04</name><pose>-1.0 7.9 0.0 0 0 0</pose><uri>model://tecnofest_buoy_boundary_orange</uri></include>
    <include><name>p2_top_edge_05</name><pose>4.0 7.3 0.0 0 0 0</pose><uri>model://tecnofest_buoy_boundary_orange</uri></include>
    <include><name>p2_top_edge_06</name><pose>9.0 6.8 0.0 0 0 0</pose><uri>model://tecnofest_buoy_boundary_orange</uri></include>
    <include><name>p2_top_edge_07</name><pose>14.0 6.2 0.0 0 0 0</pose><uri>model://tecnofest_buoy_boundary_orange</uri></include>
    <include><name>p2_top_edge_08</name><pose>19.0 5.7 0.0 0 0 0</pose><uri>model://tecnofest_buoy_boundary_orange</uri></include>
    <include><name>p2_top_edge_09</name><pose>24.0 5.2 0.0 0 0 0</pose><uri>model://tecnofest_buoy_boundary_orange</uri></include>
    <include><name>p2_top_edge_10</name><pose>29.0 4.6 0.0 0 0 0</pose><uri>model://tecnofest_buoy_boundary_orange</uri></include>
    <include><name>p2_top_edge_11</name><pose>34.0 4.1 0.0 0 0 0</pose><uri>model://tecnofest_buoy_boundary_orange</uri></include>

    <include><name>p2_bottom_edge_01</name><pose>-16.0 -0.5 0.0 0 0 0</pose><uri>model://tecnofest_buoy_boundary_orange</uri></include>
    <include><name>p2_bottom_edge_02</name><pose>-11.0 -1.0 0.0 0 0 0</pose><uri>model://tecnofest_buoy_boundary_orange</uri></include>
    <include><name>p2_bottom_edge_03</name><pose>-6.0 -1.6 0.0 0 0 0</pose><uri>model://tecnofest_buoy_boundary_orange</uri></include>
    <include><name>p2_bottom_edge_04</name><pose>-1.0 -2.1 0.0 0 0 0</pose><uri>model://tecnofest_buoy_boundary_orange</uri></include>
    <include><name>p2_bottom_edge_05</name><pose>4.0 -2.7 0.0 0 0 0</pose><uri>model://tecnofest_buoy_boundary_orange</uri></include>
    <include><name>p2_bottom_edge_06</name><pose>9.0 -3.2 0.0 0 0 0</pose><uri>model://tecnofest_buoy_boundary_orange</uri></include>
    <include><name>p2_bottom_edge_07</name><pose>14.0 -3.8 0.0 0 0 0</pose><uri>model://tecnofest_buoy_boundary_orange</uri></include>
    <include><name>p2_bottom_edge_08</name><pose>19.0 -4.3 0.0 0 0 0</pose><uri>model://tecnofest_buoy_boundary_orange</uri></include>
    <include><name>p2_bottom_edge_09</name><pose>24.0 -4.8 0.0 0 0 0</pose><uri>model://tecnofest_buoy_boundary_orange</uri></include>
    <include><name>p2_bottom_edge_10</name><pose>29.0 -5.4 0.0 0 0 0</pose><uri>model://tecnofest_buoy_boundary_orange</uri></include>
    <include><name>p2_bottom_edge_11</name><pose>34.0 -5.9 0.0 0 0 0</pose><uri>model://tecnofest_buoy_boundary_orange</uri></include>

    <include><name>p2_obstacle_01</name><pose>-13.5 1.7 0.0 0 0 0</pose><uri>model://tecnofest_buoy_obstacle_yellow</uri></include>
    <include><name>p2_obstacle_02</name><pose>-8.5 6.2 0.0 0 0 0</pose><uri>model://tecnofest_buoy_obstacle_yellow</uri></include>
    <include><name>p2_obstacle_03</name><pose>-3.5 0.6 0.0 0 0 0</pose><uri>model://tecnofest_buoy_obstacle_yellow</uri></include>
    <include><name>p2_obstacle_04</name><pose>1.5 5.1 0.0 0 0 0</pose><uri>model://tecnofest_buoy_obstacle_yellow</uri></include>
    <include><name>p2_obstacle_05</name><pose>6.5 -0.4 0.0 0 0 0</pose><uri>model://tecnofest_buoy_obstacle_yellow</uri></include>
    <include><name>p2_obstacle_06</name><pose>11.5 4.0 0.0 0 0 0</pose><uri>model://tecnofest_buoy_obstacle_yellow</uri></include>
    <include><name>p2_obstacle_07</name><pose>16.5 -1.5 0.0 0 0 0</pose><uri>model://tecnofest_buoy_obstacle_yellow</uri></include>
    <include><name>p2_obstacle_08</name><pose>21.5 2.9 0.0 0 0 0</pose><uri>model://tecnofest_buoy_obstacle_yellow</uri></include>
    <include><name>p2_obstacle_09</name><pose>26.5 -2.6 0.0 0 0 0</pose><uri>model://tecnofest_buoy_obstacle_yellow</uri></include>
    <include><name>p2_obstacle_10</name><pose>31.5 1.9 0.0 0 0 0</pose><uri>model://tecnofest_buoy_obstacle_yellow</uri></include>

    <!-- Parkur 3: target buoys stacked vertically, matching the reference order. -->
    <include><name>course3_target_red</name><pose>46.0 6.6 0.0 0 0 0</pose><uri>model://tecnofest_buoy_target_red</uri></include>
    <include><name>course3_target_green</name><pose>46.0 1.8 0.0 0 0 0</pose><uri>model://tecnofest_buoy_target_green</uri></include>
    <include><name>course3_target_black</name><pose>46.0 -3.0 0.0 0 0 0</pose><uri>model://tecnofest_buoy_target_black</uri></include>

    <include>
      <name>gamantaray_boat</name>
      <pose>-49.0 -8.0 0.35 0 0 0.42</pose>
      <uri>model://gamantaray_boat</uri>
    </include>
  </world>
</sdf>
